            <field name="route_id" ref="route_fac_returnable_packaging_inspection"/><field name="warehouse_id" ref="warehouse_factory"/><field name="company_id" ref="company_fmcg_manufacturing"/>
            <field name="location_src_id" ref="location_returnable_packaging"/><field name="location_dest_id" ref="location_packaging_inspection"/>
            <field name="location_dest_from_rule" eval="True"/><field name="picking_type_id" ref="picking_type_packaging_inspection"/>
        </record>

