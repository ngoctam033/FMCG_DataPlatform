        <record id="rule_fac_packaging_repair_to_reinspection" model="stock.rule">
            <field name="name">FAC: Packaging Repair → Reinspection</field><field name="sequence">10</field>
            <field name="action">push</field><field name="auto">manual</field><field name="procure_method">make_to_stock</field>
