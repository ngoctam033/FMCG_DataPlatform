            <field name="company_id" ref="company_fmcg_manufacturing"/><field name="warehouse_id" ref="warehouse_factory"/>
            <field name="default_location_src_id" ref="stock.stock_location_customers"/><field name="default_location_dest_id" ref="location_returnable_packaging"/>
