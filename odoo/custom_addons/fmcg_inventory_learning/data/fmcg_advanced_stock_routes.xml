            <field name="location_src_id" ref="location_packaging_repair"/><field name="location_dest_id" ref="location_packaging_inspection"/>
            <field name="location_dest_from_rule" eval="True"/><field name="picking_type_id" ref="picking_type_packaging_reinspection"/>
