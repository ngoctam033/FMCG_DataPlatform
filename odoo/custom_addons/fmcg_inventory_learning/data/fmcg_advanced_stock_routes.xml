            <field name="location_src_id" ref="location_factory_quarantine"/><field name="location_dest_id" ref="location_quarantine_inspection"/>
            <field name="location_dest_from_rule" eval="True"/><field name="picking_type_id" ref="picking_type_quarantine_reinspection"/>
        </record>

