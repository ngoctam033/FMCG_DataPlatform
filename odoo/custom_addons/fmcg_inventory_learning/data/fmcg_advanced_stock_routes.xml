            <field name="company_id" ref="company_fmcg_manufacturing"/><field name="warehouse_id" ref="warehouse_factory"/>
            <field name="default_location_src_id" ref="location_factory_quarantine"/><field name="default_location_dest_id" ref="location_quarantine_inspection"/>
        </record>
        <record id="picking_type_quarantine_pass" model="stock.picking.type">
