            <field name="company_id" ref="company_fmcg_manufacturing"/><field name="product_selectable" eval="False"/><field name="product_categ_selectable" eval="False"/>
            <field name="warehouse_selectable" eval="True"/><field name="warehouse_ids" eval="[(4, ref('warehouse_factory'))]"/>
