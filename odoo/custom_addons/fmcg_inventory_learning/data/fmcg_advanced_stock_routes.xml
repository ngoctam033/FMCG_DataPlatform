            <field name="code">CDC</field>
            <field name="company_id" ref="company_fmcg_manufacturing"/>
            <field name="reception_steps">three_steps</field>
            <field name="delivery_steps">pick_ship</field>
            <field name="resupply_wh_ids" eval="[(4, ref('warehouse_factory'))]"/>
        </record>
        <record id="warehouse_rdc_north" model="stock.warehouse">
            <field name="name">FMCG Northern Regional DC</field>
            <field name="code">RDCN</field>
