        <record id="route_fac_cross_dock_selected" model="stock.route">
            <field name="name">FAC: Selected Product Cross-Dock</field><field name="sequence">15</field>
            <field name="company_id" ref="company_fmcg_manufacturing"/>
            <field name="product_selectable" eval="True"/><field name="product_categ_selectable" eval="True"/><field name="warehouse_selectable" eval="False"/>
        </record>
        <record id="rule_fac_cross_dock_selected" model="stock.rule">
            <field name="name">FAC: Input → Output (Cross-Dock)</field><field name="sequence">5</field>
            <field name="action">push</field><field name="auto">manual</field><field name="procure_method">make_to_stock</field>
            <field name="route_id" ref="route_fac_cross_dock_selected"/><field name="warehouse_id" ref="warehouse_factory"/><field name="company_id" ref="company_fmcg_manufacturing"/>
            <field name="location_src_id" model="stock.location" search="[('complete_name', '=', 'FAC/Input')]"/>
            <field name="location_dest_id" model="stock.location" search="[('complete_name', '=', 'FAC/Output')]"/>
            <field name="location_dest_from_rule" eval="True"/><field name="picking_type_id" model="stock.picking.type" search="[('warehouse_id', '=', ref('warehouse_factory')), ('sequence_code', '=', 'XD')]"/>
        </record>
    </data>
</odoo>
