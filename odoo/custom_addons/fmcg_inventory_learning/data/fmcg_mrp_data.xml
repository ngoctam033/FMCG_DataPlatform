        <record id="workcenter_mix" model="mrp.workcenter">
            <field name="name">Mixing</field>
            <field name="code">MIX</field>
            <field name="time_efficiency">95</field>
            <field name="costs_hour">450000</field>
            <field name="resource_calendar_id" search="[('name', '=', 'Standard 40 hours/week')]"/>
            <field name="active" eval="True"/>
        </record>
