            <field name="expiration_date" eval="datetime.now() + timedelta(days=180)"/><field name="use_date" eval="datetime.now() + timedelta(days=150)"/><field name="removal_date" eval="datetime.now() + timedelta(days=135)"/><field name="alert_date" eval="datetime.now() + timedelta(days=120)"/>
