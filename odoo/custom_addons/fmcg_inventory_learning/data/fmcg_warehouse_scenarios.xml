            <field name="code">internal</field><field name="sequence_code">RCSCRP</field><field name="sequence">79</field>
            <field name="company_id" ref="company_fmcg_manufacturing"/><field name="warehouse_id" ref="warehouse_factory"/>
            <field name="default_location_src_id" ref="location_recall_inspection"/><field name="default_location_dest_id" ref="location_fmcg_scrap"/>
