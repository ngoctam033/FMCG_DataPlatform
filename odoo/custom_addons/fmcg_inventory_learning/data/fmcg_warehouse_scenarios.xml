            <field name="company_id" ref="company_fmcg_manufacturing"/><field name="warehouse_id" ref="warehouse_factory"/>
            <field name="default_location_src_id" ref="location_fac_rework"/><field name="default_location_dest_id" ref="location_quarantine_inspection"/>
