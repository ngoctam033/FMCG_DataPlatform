        <record id="picking_type_damage_to_rework" model="stock.picking.type">
            <field name="name">Damage Inspection - Rework</field>
            <field name="code">internal</field><field name="sequence_code">DMGRWK</field><field name="sequence">72</field>
            <field name="company_id" ref="company_fmcg_manufacturing"/><field name="warehouse_id" ref="warehouse_factory"/>
            <field name="default_location_src_id" ref="location_damage_inspection"/><field name="default_location_dest_id" ref="location_fac_rework"/>
        </record>
        <record id="picking_type_recall_to_rework" model="stock.picking.type">
