<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        FMCG inventory governance loaded last.

        Reusable definitions are shared across companies. Operational records
        (warehouses, locations, routes and orderpoints) remain company-specific.
        Functions are intentional here because several source records were
        originally installed with noupdate="1" and must also be corrected on
        existing databases.
    -->
    <data noupdate="0">
        <!-- ============================================================ -->
        <!-- SHARED MULTI-COMPANY MASTER DATA                             -->
        <!-- ============================================================ -->
        <function model="stock.package.type" name="write">
            <value eval="[ref('package_type_fmcg_carton')]"/>
            <value eval="{'company_id': False, 'barcode': 'FMCG-PKG-CARTON', 'sequence_code': 'FMCG-CAR-'}"/>
        </function>
        <function model="stock.package.type" name="write">
            <value eval="[ref('package_type_fmcg_shrink_wrap')]"/>
            <value eval="{'company_id': False, 'barcode': 'FMCG-PKG-SHRINK', 'sequence_code': 'FMCG-SHR-'}"/>
        </function>
        <function model="stock.package.type" name="write">
            <value eval="[ref('package_type_fmcg_euro_pallet')]"/>
            <value eval="{'company_id': False, 'barcode': 'FMCG-PKG-PALLET', 'sequence_code': 'FMCG-PAL-'}"/>
        </function>
        <function model="stock.package.type" name="write">
            <value eval="[ref('package_type_fmcg_picking_tote')]"/>
            <value eval="{'company_id': False, 'barcode': 'FMCG-PKG-TOTE', 'sequence_code': 'FMCG-TOT-'}"/>
        </function>
        <function model="stock.package.type" name="write">
            <value eval="[ref('package_type_fmcg_thermal_box')]"/>
            <value eval="{'company_id': False, 'barcode': 'FMCG-PKG-THERMAL', 'sequence_code': 'FMCG-THM-'}"/>
        </function>

        <function model="stock.storage.category" name="write">
            <value eval="[
                ref('storage_category_food_grade'),
                ref('storage_category_finished_goods'),
                ref('storage_category_packaging'),
                ref('storage_category_chemical'),
                ref('storage_category_cold'),
                ref('storage_category_frozen'),
            ]"/>
            <value eval="{'company_id': False}"/>
        </function>

