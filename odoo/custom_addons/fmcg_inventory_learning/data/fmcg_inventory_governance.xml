                ref('product_category_fmcg_raw_material'),
                ref('product_category_fmcg_cosmetics'),
                ref('product_category_fmcg_consumables'),
            ]"/>
            <value eval="{'removal_strategy_id': ref('product_expiry.removal_fefo')}"/>
        </function>

