            <value eval="{'company_id': False}"/>
        </function>

        <!-- Every category below contains lot-tracked products with expiration
             dates, therefore FEFO is the mandatory removal policy. -->
        <function model="product.category" name="write">
            <value eval="[
                ref('product_category_fmcg_milk'),
                ref('product_category_fmcg_instant_food'),
                ref('product_category_fmcg_snack'),
                ref('product_category_fmcg_condiment'),
