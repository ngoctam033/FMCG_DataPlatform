                ref('supplierinfo_product_rm_seasoning'),
                ref('supplierinfo_product_rm_potato'),
                ref('supplierinfo_product_rm_veg_oil'),
                ref('supplierinfo_product_rm_cleaning_base'),
                ref('supplierinfo_product_rm_chili_paste'),
                ref('supplierinfo_product_pm_bottle_generic'),
                ref('supplierinfo_product_pm_can_330'),
                ref('supplierinfo_product_pm_pouch_generic'),
                ref('supplierinfo_product_trade_tissue_10'),
                ref('supplierinfo_product_trade_toothpaste_180'),
                ref('supplierinfo_product_trade_shampoo_650'),
                ref('supplierinfo_product_trade_shower_gel_500'),
                ref('supplierinfo_product_trade_handwash_500'),
                ref('supplierinfo_product_trade_floor_cleaner_1l'),
                ref('supplierinfo_product_trade_fabric_softener_2l'),
                ref('supplierinfo_product_trade_coffee_3in1_20'),
                ref('supplierinfo_product_trade_biscuit_300'),
                ref('supplierinfo_product_trade_fish_sauce_750'),
                ref('supplierinfo_product_frozen_dumpling_500'),
                ref('supplierinfo_product_frozen_icecream_450'),
                ref('supplierinfo_specialist_product_rm_wheat_flour'),
                ref('supplierinfo_specialist_product_rm_seasoning'),
                ref('supplierinfo_specialist_product_rm_potato'),
                ref('supplierinfo_specialist_product_rm_veg_oil'),
                ref('supplierinfo_specialist_product_rm_chili_paste'),
                ref('supplierinfo_specialist_product_rm_cleaning_base'),
                ref('supplierinfo_specialist_product_pm_bottle_generic'),
                ref('supplierinfo_specialist_product_pm_can_330'),
                ref('supplierinfo_specialist_product_pm_pouch_generic'),
                ref('supplierinfo_specialist_product_trade_tissue_10'),
                ref('supplierinfo_specialist_product_trade_toothpaste_180'),
                ref('supplierinfo_specialist_product_trade_shampoo_650'),
                ref('supplierinfo_specialist_product_trade_shower_gel_500'),
                ref('supplierinfo_specialist_product_trade_handwash_500'),
                ref('supplierinfo_specialist_product_trade_floor_cleaner_1l'),
