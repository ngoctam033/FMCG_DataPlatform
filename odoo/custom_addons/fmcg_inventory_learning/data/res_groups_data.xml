<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 1. Bật tính năng: Quản lý theo Lô & Serial Numbers -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('stock.group_production_lot'))]"/>
        </record>
        
        <!-- 2. Bật tính năng: Product Packagings -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('product.group_stock_packaging'))]"/>
        </record>

        <!-- 3. Bật tính năng: Đa kho (Storage Locations) và Đa luồng (Multi-Step Routes) -->
        <record id="base.group_user" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('stock.group_stock_multi_locations')), (4, ref('stock.group_adv_location'))]"/>
        </record>
    </data>
</odoo>
