<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Dedicated journal for manually entered FMCG simulation entries. -->
        <record id="journal_fmcg_simulation" model="account.journal">
            <field name="name">FMCG Simulation Entries</field>
            <field name="code">FSIM</field>
            <field name="type">general</field>
            <field name="company_id" ref="base.main_company"/>
            <field name="default_account_id" ref="account.1_chart632"/>
        </record>

        <!-- Accounting user used for journal-entry learning scenarios. -->
        <record id="user_accounting_simulator" model="res.users">
            <field name="name">Accounting User Simulator</field>
            <field name="login">accounting.user.simulator</field>
            <field name="active" eval="True"/>
            <field name="group_ids" eval="[(6, 0, [
                ref('base.group_user'),
                ref('account.group_account_user')
            ])]"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="company_ids" eval="[(6, 0, [
                ref('base.main_company'),
                ref('company_fmcg_manufacturing'),
                ref('company_fmcg_distribution')
            ])]"/>
        </record>

        <!-- FMCG cost-center plan and analytic accounts. -->
        <record id="analytic_plan_fmcg_cost_centers" model="account.analytic.plan">
            <field name="name">FMCG Cost Centers</field>
        </record>

        <record id="analytic_account_fmcg_holding" model="account.analytic.account">
            <field name="name">FMCG Group - Holding</field>
            <field name="code">CC-HOLDING</field>
            <field name="plan_id" ref="analytic_plan_fmcg_cost_centers"/>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="analytic_account_fmcg_manufacturing" model="account.analytic.account">
            <field name="name">FMCG Manufacturing - Factory</field>
            <field name="code">CC-FACTORY</field>
            <field name="plan_id" ref="analytic_plan_fmcg_cost_centers"/>
            <field name="company_id" ref="company_fmcg_manufacturing"/>
        </record>

        <record id="analytic_account_fmcg_distribution" model="account.analytic.account">
            <field name="name">FMCG Trading - Distribution</field>
            <field name="code">CC-DIST</field>
            <field name="plan_id" ref="analytic_plan_fmcg_cost_centers"/>
            <field name="company_id" ref="company_fmcg_distribution"/>
        </record>

        <!--
            Vietnamese chart accounts generated for the main company by l10n_vn:
            5110 Revenue, 6320 COGS, 1520 Inventory, 6350 Price Differences.
            These properties are company-dependent and are initialized here for
            the main company, from which the two child companies inherit.
        -->
        <record id="product_category_fmcg_milk" model="product.category">
            <field name="property_cost_method">average</field>
            <field name="property_valuation">real_time</field>
            <field name="property_account_income_categ_id" ref="account.1_chart5111"/>
            <field name="property_account_expense_categ_id" ref="account.1_chart632"/>
            <field name="property_stock_journal" ref="account.1_inventory_valuation"/>
            <field name="property_stock_valuation_account_id" ref="account.1_chart152"/>
            <field name="property_price_difference_account_id" ref="account.1_chart635"/>
        </record>

        <record id="product_category_fmcg_instant_food" model="product.category">
            <field name="property_cost_method">average</field>
            <field name="property_valuation">real_time</field>
            <field name="property_account_income_categ_id" ref="account.1_chart5111"/>
            <field name="property_account_expense_categ_id" ref="account.1_chart632"/>
            <field name="property_stock_journal" ref="account.1_inventory_valuation"/>
            <field name="property_stock_valuation_account_id" ref="account.1_chart152"/>
            <field name="property_price_difference_account_id" ref="account.1_chart635"/>
        </record>

        <record id="product_category_fmcg_snack" model="product.category">
            <field name="property_cost_method">average</field>
            <field name="property_valuation">real_time</field>
            <field name="property_account_income_categ_id" ref="account.1_chart5111"/>
            <field name="property_account_expense_categ_id" ref="account.1_chart632"/>
            <field name="property_stock_journal" ref="account.1_inventory_valuation"/>
            <field name="property_stock_valuation_account_id" ref="account.1_chart152"/>
            <field name="property_price_difference_account_id" ref="account.1_chart635"/>
        </record>

        <record id="product_category_fmcg_condiment" model="product.category">
            <field name="property_cost_method">average</field>
            <field name="property_valuation">real_time</field>
            <field name="property_account_income_categ_id" ref="account.1_chart5111"/>
            <field name="property_account_expense_categ_id" ref="account.1_chart632"/>
            <field name="property_stock_journal" ref="account.1_inventory_valuation"/>
            <field name="property_stock_valuation_account_id" ref="account.1_chart152"/>
            <field name="property_price_difference_account_id" ref="account.1_chart635"/>
        </record>

        <record id="product_category_fmcg_frozen" model="product.category">
            <field name="property_cost_method">average</field>
            <field name="property_valuation">real_time</field>
            <field name="property_account_income_categ_id" ref="account.1_chart5111"/>
            <field name="property_account_expense_categ_id" ref="account.1_chart632"/>
            <field name="property_stock_journal" ref="account.1_inventory_valuation"/>
            <field name="property_stock_valuation_account_id" ref="account.1_chart152"/>
            <field name="property_price_difference_account_id" ref="account.1_chart635"/>
        </record>

        <record id="product_category_fmcg_raw_material" model="product.category">
            <field name="property_cost_method">average</field>
            <field name="property_valuation">real_time</field>
            <field name="property_account_income_categ_id" ref="account.1_chart5111"/>
            <field name="property_account_expense_categ_id" ref="account.1_chart632"/>
            <field name="property_stock_journal" ref="account.1_inventory_valuation"/>
            <field name="property_stock_valuation_account_id" ref="account.1_chart152"/>
            <field name="property_price_difference_account_id" ref="account.1_chart635"/>
        </record>
    </data>
</odoo>
