    <!--
        The legacy XML record is noupdate data and cannot be moved to another
        company: Odoo explicitly forbids changing an orderpoint's company.
        Archive it on installation/upgrade and keep the FAC rule above as the
        active rule for this product.
    -->
    <data noupdate="0">
        <function model="stock.warehouse.orderpoint" name="write">
            <value eval="[ref('orderpoint_rm_cleaning_base')]"/>
            <value eval="{'active': False}"/>
