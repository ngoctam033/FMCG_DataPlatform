        </record>
        <!--
            Factory replenishment rule for RM-CLEANING-BASE.

            The legacy orderpoint above belongs to the holding company's WH/Stock.
            FAC uses three-step receipts, so procurement must target FAC/Stock; the
            warehouse routes then create Vendors -> Input -> Quality Control -> Stock.
        -->
        <record id="orderpoint_rm_cleaning_base_fac" model="stock.warehouse.orderpoint">
            <field name="product_id" search="[('default_code', '=', 'RM-CLEANING-BASE')]"/>
            <field name="company_id" ref="company_fmcg_manufacturing"/>
            <field name="warehouse_id" ref="warehouse_factory"/>
            <field name="location_id"
                   model="stock.location"
                   search="[('complete_name', '=', 'FAC/Stock'), ('company_id', '=', ref('company_fmcg_manufacturing'))]"/>
            <field name="route_id" ref="purchase_stock.route_warehouse0_buy"/>
            <field name="product_min_qty">500</field>
            <field name="product_max_qty">2500</field>
            <field name="trigger">auto</field>
        </record>
        <!--
            Demand-driven replenishment for purified water at FAC/Stock.

            FAC/PICK demand decreases the forecast quantity at FAC/Stock.
            With Min = Max = 0, Odoo proposes exactly enough quantity to
            cover the negative forecast, without maintaining safety stock.
        -->
        <record id="orderpoint_rm_purified_water_fac"
                model="stock.warehouse.orderpoint">
            <field name="product_id"
                search="[('default_code', '=', 'RM-PURIFIED-WATER')]"/>

            <field name="company_id"
                ref="company_fmcg_manufacturing"/>

            <field name="warehouse_id"
                ref="warehouse_factory"/>

            <field name="location_id"
                model="stock.location"
                search="[
                    ('complete_name', '=', 'FAC/Stock'),
                    ('company_id', '=', ref('company_fmcg_manufacturing'))
                ]"/>

            <field name="route_id"
                ref="purchase_stock.route_warehouse0_buy"/>

            <field name="product_min_qty">0</field>
            <field name="product_max_qty">0</field>

            <field name="trigger">auto</field>
        </record>
