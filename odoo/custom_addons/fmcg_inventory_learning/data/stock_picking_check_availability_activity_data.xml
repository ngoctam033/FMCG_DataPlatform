<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_activity_type_check_picking_availability" model="mail.activity.type">
            <field name="name">Kiểm tra khả dụng</field>
            <field name="summary">Kiểm tra khả dụng của phiếu kho</field>
            <field name="icon">fa-cubes</field>
            <field name="sequence">10</field>
            <field name="delay_count">0</field>
            <field name="res_model">stock.picking</field>
        </record>

        <record id="automation_check_picking_availability_on_waiting" model="base.automation">
            <field name="name">Yêu cầu kiểm tra khả dụng khi phiếu kho chờ</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="trigger">on_create_or_write</field>
            <field name="trigger_field_ids" eval="[(6, 0, [ref('stock.field_stock_picking__state')])]"/>
            <field name="filter_pre_domain">[("state", "!=", "waiting")]</field>
            <field name="filter_domain">[("state", "=", "waiting")]</field>
            <field name="active" eval="True"/>
        </record>

        <record id="server_action_check_picking_availability_on_waiting" model="ir.actions.server">
            <field name="name">Tạo hoạt động kiểm tra khả dụng</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_check_picking_availability_on_waiting"/>
            <field name="state">next_activity</field>
            <field name="activity_type_id" ref="mail_activity_type_check_picking_availability"/>
            <field name="activity_summary">Kiểm tra khả dụng của phiếu kho</field>
            <field name="activity_note">Vui lòng kiểm tra khả dụng và khả năng giữ hàng cho phiếu kho này.</field>
            <field name="activity_date_deadline_range">0</field>
            <field name="activity_date_deadline_range_type">days</field>
            <field name="activity_user_type">generic</field>
            <field name="activity_user_field_name">user_id</field>
        </record>
    </data>
</odoo>
