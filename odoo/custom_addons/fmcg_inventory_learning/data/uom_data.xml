<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Đơn vị tính: Lốc (6 hộp) -->
        <record id="uom_pack_6" model="uom.uom">
            <field name="name">Lốc (6 Hộp)</field>
            <!-- Tham chiếu về đơn vị cơ bản mặc định của Odoo (Units) -->
            <field name="relative_uom_id" ref="uom.product_uom_unit"/>
            <!-- 1 Lốc = 6 Units -->
            <field name="relative_factor" eval="6.0"/>
        </record>

        <!-- Đơn vị tính: Thùng (24 hộp = 4 Lốc) -->
        <record id="uom_box_24" model="uom.uom">
            <field name="name">Thùng (24 Hộp)</field>
            <field name="relative_uom_id" ref="uom.product_uom_unit"/>
            <!-- 1 Thùng = 24 Units -->
            <field name="relative_factor" eval="24.0"/>
        </record>

        <!-- Đơn vị tính: Pallet (bằng 50 Thùng = 1200 Hộp) -->
        <record id="uom_pallet" model="uom.uom">
            <field name="name">Pallet (50 Thùng)</field>
            <field name="relative_uom_id" ref="uom.product_uom_unit"/>
            <!-- 1 Pallet = 1200 Units -->
            <field name="relative_factor" eval="1200.0"/>
        </record>
    </data>
</odoo>