<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Confirm: draft -> confirmed (when no blocking dependency) -->
    <record id="mail_activity_type_picking_confirmed" model="mail.activity.type">
        <field name="name">Picking: Confirm</field>
        <field name="summary">Confirm stock picking</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-check</field>
        <field name="sequence">10</field>
    </record>

    <!-- 2. Waiting: state is derived from stock move dependencies -->
    <record id="mail_activity_type_picking_waiting" model="mail.activity.type">
        <field name="name">Picking: Check Waiting</field>
        <field name="summary">Check dependencies and waiting operations</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-clock-o</field>
        <field name="sequence">20</field>
    </record>

    <!-- 3. Assigned: reserve stock -->
    <record id="mail_activity_type_picking_assigned" model="mail.activity.type">
        <field name="name">Picking: Assign</field>
        <field name="summary">Reserve available stock</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-cubes</field>
        <field name="sequence">30</field>
    </record>

    <!-- 4. Done: validate transfer -->
    <record id="mail_activity_type_picking_done" model="mail.activity.type">
        <field name="name">Picking: Validate</field>
        <field name="summary">Validate stock picking</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-check-square-o</field>
        <field name="sequence">40</field>
    </record>

    <!-- 5. Cancel: cancel transfer -->
    <record id="mail_activity_type_picking_cancel" model="mail.activity.type">
        <field name="name">Picking: Cancel</field>
        <field name="summary">Cancel stock picking</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-ban</field>
        <field name="sequence">50</field>
    </record>
</odoo>