<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Activity Type: Validate Assigned Picking -->
    <record id="mail_activity_type_validate_assigned_picking"
            model="mail.activity.type">
        <field name="name">Picking: Validate</field>
        <field name="summary">Validate assigned stock picking</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-check-square-o</field>
        <field name="sequence">40</field>
    </record>
    <!-- Server Action: Validate And Verify Assigned Picking -->
    <record id="action_validate_assigned_picking"
            model="ir.actions.server">
        <field name="name">Picking: Validate And Verify On Activity Done</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
picking = env['stock.picking'].browse(record.res_id).exists()

if picking and picking.state == 'assigned':
    picking.button_validate()

if picking and picking.state != 'done':
    raise UserError(
        'Picking %s chưa hoàn tất sau khi gọi button_validate(). '
        'Trạng thái hiện tại: %s'
        % (picking.name, picking.state)
    )
        ]]></field>
    </record>

    <!-- 3. Automation: Validate Picking On Activity Done -->
    <record id="automation_validate_assigned_picking"
            model="base.automation">
        <field name="name">Picking: Validate On Activity Done</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_archive</field>
        <field name="filter_domain"
               eval="[
                   ('activity_type_id', '=', ref('mail_activity_type_validate_assigned_picking')),
                   ('res_model', '=', 'stock.picking')
               ]"/>
        <field name="action_server_ids"
            eval="[
                (6, 0, [
                    ref('action_validate_assigned_picking'),
                ])
            ]"/>
    </record>
</odoo>
