<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A1: Nhập hàng rời, không có package nguồn và đích -->
    <record id="ir_filter_incoming_a1_unpackaged" model="ir.filters">
        <field name="name">[A1] Incoming - Unpackaged Goods</field>
        <field name="model_id">stock.move.line</field>
        <field name="domain">[
            ('picking_id.picking_type_id.code', '=', 'incoming'),
            ('package_id', '=', False),
            ('result_package_id', '=', False)
        ]</field>
        <field name="is_default" eval="False"/>
    </record>

</odoo>