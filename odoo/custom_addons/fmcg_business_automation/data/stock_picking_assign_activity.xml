<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_schedule_picking_assigned"
            model="ir.actions.server">
        <field name="name">Picking: Schedule Assign Activity</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">next_activity</field>
        <field name="activity_type_id"
            ref="fmcg_business_automation.mail_activity_type_picking_assigned"/>
        <field name="activity_summary">Reserve available stock</field>
        <field name="activity_note">
            Kiểm tra khả dụng tồn kho và thực hiện reservation
            cho Stock Picking.
        </field>
        <field name="activity_user_type">generic</field>
        <field name="activity_user_id" ref="base.user_admin"/>
    </record>

    <!-- 1. Server Action: Assign Not Implemented -->
    <record id="action_picking_assign_not_implemented"
            model="ir.actions.server">
        <field name="name">Picking: Assign Not Implemented</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
    raise UserError('Nghiệp vụ này chưa được implement!')
        ]]></field>
    </record>

    <!-- 2. Automation: On Assign Activity Done -->
    <record id="automation_picking_assign_not_implemented"
            model="base.automation">
        <field name="name">Picking: Assign Not Implemented</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_archive</field>
        <field name="filter_domain"
            eval="[
                ('activity_type_id', '=', ref('fmcg_business_automation.mail_activity_type_picking_assigned')),
                ('res_model', '=', 'stock.picking')
            ]"/>
        <field name="action_server_ids"
            eval="[(4, ref('action_picking_assign_not_implemented'))]"/>
    </record>
</odoo>