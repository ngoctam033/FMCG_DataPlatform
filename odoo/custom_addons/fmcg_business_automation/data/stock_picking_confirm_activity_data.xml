<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="mail_activity_type_confirm_draft_picking" model="mail.activity.type">
            <field name="name">Xác nhận phiếu kho nháp</field>
            <field name="summary">Xác nhận phiếu kho đang Nháp</field>
            <field name="icon">fa-check-circle</field>
            <field name="sequence">10</field>
            <field name="delay_count">0</field>
            <field name="res_model">stock.picking</field>
            <field name="chaining_type">trigger</field>
            <field name="triggered_next_type_id"
                ref="fmcg_business_automation.mail_activity_type_validate_picking"/>
        </record>
        <record id="automation_confirm_draft_picking" model="base.automation">
            <field name="name">Tạo hoạt động xác nhận phiếu kho nháp</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="trigger">on_create_or_write</field>
            <field name="trigger_field_ids" eval="[(6, 0, [ref('stock.field_stock_picking__state')])]"/>
            <field name="filter_pre_domain">[("state", "!=", "draft")]</field>
            <field name="filter_domain">[("state", "=", "draft")]</field>
            <field name="active" eval="True"/>
        </record>

        <record id="server_action_confirm_draft_picking" model="ir.actions.server">
            <field name="name">Xác nhận phiếu kho đang Nháp</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_confirm_draft_picking"/>
            <field name="state">next_activity</field>
            <field name="activity_type_id" ref="mail_activity_type_confirm_draft_picking"/>
            <field name="activity_summary">Xác nhận phiếu kho đang Nháp</field>
            <field name="activity_note">Vui lòng kiểm tra và xác nhận phiếu kho này.</field>
            <field name="activity_date_deadline_range">0</field>
            <field name="activity_date_deadline_range_type">days</field>
            <field name="activity_user_type">generic</field>
            <field name="activity_user_field_name">user_id</field>
        </record>
    </data>

    <data noupdate="0">
        <record id="automation_log_archived_mail_activity" model="base.automation">
            <field name="name">Log loại hoạt động khi hoàn thành</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="trigger">on_archive</field>
            <field name="active" eval="False"/>
        </record>

        <record id="server_action_log_archived_mail_activity_type" model="ir.actions.server">
            <field name="name">Log loại hoạt động đã hoàn thành</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_log_archived_mail_activity"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
activity = record.with_user(record.user_id)
log(
    "Archived mail.activity id=%s, activity_type_id=%s, activity_type=%s"
    % (
        activity.id,
        activity.activity_type_id.id,
        activity.activity_type_id.display_name,
    ),
    level="info",
)
            ]]></field>
        </record>

        <record id="automation_confirm_picking_on_activity_done" model="base.automation">
            <field name="name">Xác nhận phiếu kho khi hoàn thành hoạt động</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="trigger">on_archive</field>
            <field name="active" eval="True"/>
        </record>

        <record id="server_action_confirm_picking_on_activity_done" model="ir.actions.server">
            <field name="name">Xác nhận phiếu kho nguồn</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_confirm_picking_on_activity_done"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
activity = record.with_user(record.user_id)
if (
    activity.activity_type_id
    == activity.env.ref('fmcg_business_automation.mail_activity_type_confirm_draft_picking')
    and activity.res_model == 'stock.picking'
):
    source_record = activity.env['stock.picking'].browse(activity.res_id)
    if source_record.state == 'draft':
        source_record.action_confirm()
            ]]></field>
        </record>
    </data>
</odoo>
