<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Activity yêu cầu chọn Lot/Serial có sẵn trong tồn kho -->
    <record id="mail_activity_type_picking_assign_existing_lot_serial"
            model="mail.activity.type">
        <field name="name">
            Picking: Assign Existing Lot/Serial
        </field>
        <field name="summary">
            Assign existing Lot/Serial from available stock
        </field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-cubes</field>
        <field name="sequence">46</field>
    </record>

    <!--
        Action điều phối:
        Được gọi từ action_picking_fill_missing_lot_serial
        và gắn activity mới vào source picking.
    -->
    <record id="action_picking_assign_existing_lot_serial"
            model="ir.actions.server">
        <field name="name">
            Picking: Schedule Assign Existing Lot/Serial
        </field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
picking = env['stock.picking'].browse(record.res_id).exists()

activity_type = env.ref(
    'fmcg_business_automation.'
    'mail_activity_type_picking_assign_existing_lot_serial'
)
picking.activity_schedule(
    activity_type_id=activity_type.id,
    summary='Assign existing Lot/Serial from available stock',
    user_id=record.user_id.id or env.user.id,
)
        ]]></field>
    </record>

    <!--
        Action nghiệp vụ:
        Sẽ được gọi khi activity Assign Existing Lot/Serial được Done.
        Tạm thời là placeholder.
    -->
    <record id="action_picking_process_existing_lot_serial"
            model="ir.actions.server">
        <field name="name">
            Picking: Process Existing Lot/Serial On Activity Done
        </field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
picking = env['stock.picking'].browse(record.res_id).exists()

raise UserError(
    'Placeholder: Chưa triển khai nghiệp vụ chọn Lot/Serial '
    'có tồn kho khả dụng cho Picking %s.'
    % picking.display_name
)
        ]]></field>
    </record>

    <!-- Khi activity Assign Existing Lot/Serial được đánh dấu Done -->
    <record id="automation_picking_process_existing_lot_serial"
            model="base.automation">
        <field name="name">
            Picking: Process Existing Lot/Serial On Activity Done
        </field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_archive</field>

        <field name="filter_domain"
               eval="[
                   (
                       'activity_type_id',
                       '=',
                       ref(
                           'mail_activity_type_picking_assign_existing_lot_serial'
                       )
                   ),
                   ('res_model', '=', 'stock.picking')
               ]"/>

        <field name="action_server_ids"
               eval="[
                   (
                       4,
                       ref(
                           'action_picking_process_existing_lot_serial'
                       )
                   )
               ]"/>
    </record>

</odoo>