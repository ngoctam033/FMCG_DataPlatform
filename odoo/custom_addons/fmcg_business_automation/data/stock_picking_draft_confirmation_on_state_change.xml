<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="automation_schedule_confirm_draft_picking_on_state_change"
            model="base.automation">
        <field name="name">
            Picking: Schedule Confirmation When State Becomes Draft
        </field>

        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="trigger">on_write</field>

        <field name="trigger_field_ids"
               eval="[(6, 0, [ref('stock.field_stock_picking__state')])]"/>

        <field name="filter_pre_domain">
            [('state', '!=', 'draft')]
        </field>

        <field name="filter_domain">
            [('state', '=', 'draft')]
        </field>

        <field name="action_server_ids"
               eval="[(4, ref('action_schedule_confirm_draft_picking'))]"/>

        <field name="active" eval="True"/>
    </record>
</odoo>
