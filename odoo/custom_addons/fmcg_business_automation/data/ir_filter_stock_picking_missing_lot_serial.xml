<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_filter_stock_picking_missing_lot_serial"
            model="ir.filters">
        <field name="name">Picking: Missing Lot/Serial</field>
        <field name="model_id">stock.picking</field>
        <field name="domain">[
            ('state', 'not in', ['done', 'cancel']),
            '|',
            ('picking_type_id.use_create_lots', '=', True),
            ('picking_type_id.use_existing_lots', '=', True),
            ('move_ids', 'any', [
                ('product_id.tracking', 'in', ['lot', 'serial']),
                ('move_line_ids', 'any', [
                    ('quantity', '&gt;', 0),
                    ('lot_id', '=', False),
                    ('lot_name', '=', False),
                ]),
            ]),
        ]</field>
        <field name="context">{}</field>
        <field name="sort">[]</field>
        <field name="is_default">False</field>
    </record>
</odoo>
