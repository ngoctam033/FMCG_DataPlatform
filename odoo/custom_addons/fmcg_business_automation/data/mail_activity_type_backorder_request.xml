<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Activity Type: Backorder Request -->
        <record id="mail_activity_type_backorder_request" model="mail.activity.type">
            <field name="name">Yêu cầu tạo Backorder</field>
            <field name="summary">Xác nhận tạo Backorder cho phiếu kho</field>
            <field name="icon">fa-exclamation-triangle</field>
            <field name="decoration_type">warning</field>
            <field name="res_model">stock.picking</field>
        </record>

        <!-- Automation: Trigger when Backorder Activity is archived -->
        <record id="automation_backorder_request_on_archive" model="base.automation">
            <field name="name">Backorder Request - On Archive</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="trigger">on_archive</field>
            <field name="filter_domain" eval="str([('activity_type_id', '=', ref('fmcg_business_automation.mail_activity_type_backorder_request'))])"/>
        </record>

        <!-- Server Action: Handle Backorder Request -->
        <record id="server_action_backorder_request_on_archive" model="ir.actions.server">
            <field name="name">Handle Backorder Request</field>
            <field name="model_id" ref="mail.model_mail_activity"/>
            <field name="usage">base_automation</field>
            <field name="base_automation_id" ref="automation_backorder_request_on_archive"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
raise UserError("Chưa implement nghiệp vụ này")
            ]]></field>
        </record>
    </data>
</odoo>
