<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_activity_type_review_cancel_unlinked_picking" model="mail.activity.type">
        <field name="name">Xem xét hủy phiếu Storage</field>
        <field name="summary">Kiểm tra nhu cầu và xem xét hủy phiếu Storage</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-ban</field>
        <field name="sequence">45</field>
    </record>

    <record id="automation_cancel_fac_storage_picking_on_review_archive"
            model="base.automation">
        <field name="name">Hủy phiếu Storage khi activity xem xét được archive</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_archive</field>
        <field name="filter_domain"
               eval="[
                   ('res_model', '=', 'stock.picking'),
                   ('activity_type_id', '=', ref(
                       'fmcg_business_automation.mail_activity_type_review_cancel_unlinked_picking'
                   )),
               ]"/>
    </record>

    <record id="action_cancel_fac_storage_picking_on_review_archive"
            model="ir.actions.server">
        <field name="name">Hủy phiếu Storage liên kết với activity</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="usage">base_automation</field>
        <field name="base_automation_id" ref="automation_cancel_fac_storage_picking_on_review_archive"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
pickings = env['stock.picking'].browse(records.mapped('res_id')).exists()
pickings.action_cancel()
        ]]></field>
    </record>

    <record id="action_schedule_picking_cancellation_review"
            model="ir.actions.server">
        <field name="name">Phiếu kho: Gắn yêu cầu xem xét hủy</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
picking = (records or record or model).ensure_one()

if picking.filtered_domain(env.ref(
    'fmcg_business_automation.ir_filter_stock_picking_cancellation_candidates'
)._get_eval_domain()):
    picking.activity_schedule(
        activity_type_id=env.ref(
            'fmcg_business_automation.mail_activity_type_review_cancel_unlinked_picking'
        ).id,
    )
        ]]></field>
    </record>
</odoo>