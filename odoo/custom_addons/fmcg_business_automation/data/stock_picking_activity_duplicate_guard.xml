<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Server Action: Prevent Duplicate Active Activities -->
    <record id="action_prevent_duplicate_picking_activity"
            model="ir.actions.server">
        <field name="name">Picking: Prevent Duplicate Active Activity</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
duplicate = env['mail.activity'].search([
    ('res_model', '=', record.res_model),
    ('res_id', '=', record.res_id),
    ('activity_type_id', '=', record.activity_type_id.id),
    ('id', '!=', record.id),
], limit=1)

if duplicate:
    raise UserError(
        'Picking %s đã có Activity "%s" chưa hoàn thành.'
        % (
            env['stock.picking'].browse(record.res_id).display_name,
            record.activity_type_id.name,
        )
    )
        ]]></field>
    </record>

    <!-- 2. Automation: Check On Activity Creation -->
    <record id="automation_prevent_duplicate_picking_activity"
            model="base.automation">
        <field name="name">Picking: Prevent Duplicate Active Activity</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="trigger">on_create</field>
        <field name="filter_domain"
               eval="[('res_model', '=', 'stock.picking')]"/>
        <field name="action_server_ids"
               eval="[(4, ref('action_prevent_duplicate_picking_activity'))]"/>
    </record>
</odoo>