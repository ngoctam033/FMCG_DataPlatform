<odoo>
    <record id="action_validate_stock_move_qty" model="ir.actions.server">
        <field name="name">Validate Stock Move Quantity</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for rec in records:
    if rec.product_uom_qty < 1:
        raise UserError(
            "Số lượng yêu cầu phải lớn hơn hoặc bằng 1!"
        )
        ]]></field>
    </record>

    <record id="automation_validate_stock_move_qty" model="base.automation">
        <field name="name">Validate Stock Move Quantity</field>
        <field name="model_id" ref="stock.model_stock_move"/>
        <field name="trigger">on_create_or_write</field>
        <field name="filter_domain">[('product_uom_qty', '&lt;', 1)]</field>
        <field name="trigger_field_ids" eval="[(4, ref('stock.field_stock_move__product_uom_qty'))]"/>
        <field name="action_server_ids"
               eval="[(4, ref('action_validate_stock_move_qty'))]"/>
        <field name="active" eval="True"/>
    </record>
</odoo>