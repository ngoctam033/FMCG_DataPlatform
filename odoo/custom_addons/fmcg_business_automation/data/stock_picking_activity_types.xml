<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Draft: Confirm Picking -->
    <record id="mail_activity_type_picking_draft"
            model="mail.activity.type">
        <field name="name">Xác nhận phiếu kho nháp</field>
        <field name="summary">Xác nhận phiếu kho nháp</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-file-text-o</field>
        <field name="sequence">10</field>
        <field name="delay_count">0</field>
    </record>

    <!-- 2. Waiting: Check Dependencies -->
    <record id="mail_activity_type_picking_waiting"
            model="mail.activity.type">
        <field name="name">Kiểm tra phiếu đang chờ</field>
        <field name="summary">Kiểm tra nghiệp vụ phụ thuộc</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-clock-o</field>
        <field name="sequence">20</field>
        <field name="delay_count">0</field>
    </record>

    <!-- 3. Confirmed: Check Availability -->
    <record id="mail_activity_type_picking_confirmed"
            model="mail.activity.type">
        <field name="name">Kiểm tra tồn kho</field>
        <field name="summary">Kiểm tra hàng khả dụng</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-cubes</field>
        <field name="sequence">30</field>
        <field name="delay_count">0</field>
    </record>

    <!-- 4. Assigned: Validate Picking -->
    <record id="mail_activity_type_picking_assigned"
            model="mail.activity.type">
        <field name="name">Hoàn tất phiếu kho</field>
        <field name="summary">Kiểm tra và hoàn tất phiếu kho</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-check-square-o</field>
        <field name="sequence">40</field>
        <field name="delay_count">0</field>
    </record>

    <!-- 4.1. Backorder: Require Manual Decision -->
    <record id="mail_activity_type_picking_backorder_required"
            model="mail.activity.type">
        <field name="name">Xử lý Backorder phiếu kho</field>
        <field name="summary">Phiếu kho cần quyết định tạo Backorder</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-exclamation-triangle</field>
        <field name="sequence">45</field>
        <field name="delay_count">0</field>
    </record>

    <!-- Disable automatic chaining from Draft to Assigned -->
    <record id="fmcg_business_automation.mail_activity_type_picking_draft"
            model="mail.activity.type">
        <field name="chaining_type">suggest</field>
    </record>

    <!-- 5. Done: Final Review -->
    <record id="mail_activity_type_picking_done"
            model="mail.activity.type">
        <field name="name">Hậu kiểm phiếu kho</field>
        <field name="summary">Kiểm tra kết quả hoàn tất phiếu kho</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-check-circle</field>
        <field name="sequence">50</field>
        <field name="delay_count">0</field>
    </record>

    <!-- 6. Cancel: Review Cancelled Picking -->
    <record id="mail_activity_type_picking_cancel"
            model="mail.activity.type">
        <field name="name">Kiểm tra phiếu kho đã hủy</field>
        <field name="summary">Kiểm tra và xác nhận việc hủy phiếu kho</field>
        <field name="res_model">stock.picking</field>
        <field name="icon">fa-ban</field>
        <field name="sequence">60</field>
        <field name="delay_count">0</field>
    </record>
</odoo>
