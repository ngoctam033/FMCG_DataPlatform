<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Cron: Giả lập nhân viên tạo Phiếu Kho thủ công mỗi 30 phút -->
        <record id="ir_cron_simulate_stock_picking" model="ir.cron">
            <field name="name">Simulator: Auto Create Stock Picking</field>
            <!-- Sử dụng base.model_ir_cron làm mỏ neo, không cần model_employee_simulator -->
            <field name="model_id" ref="base.model_ir_cron"/>
            <field name="state">code</field>
            <!-- Gọi thẳng vào AbstractModel qua env -->
            <field name="code">env['employee.simulator'].simulate_create_picking(record_count=100)</field>
            <field name="priority">0</field>
            <field name="interval_number">20</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_simulate_internal_transfer_create" model="ir.cron">
            <field name="name">Simulator: Create Draft Internal Transfer</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_simulate_internal_transfer_create()</field>
            <field name="priority">0</field>
            <field name="interval_number">10</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="False"/>
        </record>

        <record id="ir_cron_simulate_confirm_picking" model="ir.cron">
            <field name="name">Simulator: Tự động Xác nhận Phiếu kho</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.simulate_confirm_picking()</field>
            <field name="priority">1</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_simulate_picking_assign" model="ir.cron">
            <field name="name">Simulator: Tự động Kiểm tra Khả dụng (Assign)</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_simulate_picking_assign()</field>
            <field name="priority">2</field>
            <!-- Chạy mỗi 2 phút hoặc 1 phút tùy bạn muốn tần suất giả lập -->
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_simulate_picking_validate" model="ir.cron">
            <field name="name">Simulator: Tự động Xác nhận (Validate) Phiếu kho</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_simulate_picking_validate()</field>
            <field name="priority">3</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_find_missing_lot_pickings" model="ir.cron">
            <field name="name">Simulator: Tìm Phiếu kho thiếu Lot/Serial</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_find_missing_lot_pickings()</field>
            <field name="priority">4</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_process_missing_lot_activities" model="ir.cron">
            <field name="name">Simulator: Auto Process Missing Lot/Serial</field>
            <field name="model_id" ref="employee_simulator.model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_missing_lot_activities()</field>
            <field name="priority">5</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_process_missing_quantity_activities" model="ir.cron">
            <field name="name">Simulator: Auto Process Missing Quantities</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_process_missing_quantity_activities()</field>
            <field name="priority">5</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_find_picking_cancel_candidates" model="ir.cron">
            <field name="name">Simulator: Tìm phiếu kho để hủy</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_find_picking_cancel_candidates()</field>
            <field name="priority">8</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_simulate_picking_cancel" model="ir.cron">
            <field name="name">Simulator: Tự động hủy phiếu kho</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_simulate_picking_cancel()</field>
            <field name="priority">9</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_simulate_backorder_create" model="ir.cron">
            <field name="name">Simulator: Auto Create Backorder</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_simulate_backorder_create()</field>
            <field name="priority">6</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_simulate_backorder_cancel" model="ir.cron">
            <field name="name">Simulator: Auto Cancel Backorder</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_simulate_backorder_cancel()</field>
            <field name="priority">7</field>
            <field name="interval_number">3</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
        <record id="ir_cron_mark_done_simulate_cancel_activities" model="ir.cron">
            <field name="name">Simulator: Mark Done Activity Cancel Khi Picking Done</field>
            <field name="model_id" ref="model_employee_simulator"/>
            <field name="state">code</field>
            <field name="code">model.cron_mark_done_simulate_cancel_activities()</field>
            <field name="priority">10</field>
            <field name="interval_number">1</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
