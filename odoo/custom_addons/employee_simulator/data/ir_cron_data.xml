<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="ir_cron_simulate_create_picking" model="ir.cron">
        <field name="name">Employee Simulator: Create Pickings</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code">model.simulate_create_picking()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_action_done_activities" model="ir.cron">
        <field name="name">Employee Simulator: Complete Activities</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="state">code</field>
        <field name="code">
activity_type_xmlids = [
    'fmcg_business_automation.mail_activity_type_confirm_draft_picking',
]
activity_type_ids = [env.ref(xmlid).id for xmlid in activity_type_xmlids]
activities = env['mail.activity'].search(
    [('activity_type_id', 'in', activity_type_ids)],
    order='create_date asc, id asc',
    limit=100,
)
activities.action_done()
        </field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
