<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">
    <record id="ir_cron_simulate_create_picking" model="ir.cron">
        <field name="name">Employee Simulator: Create Pickings</field>
        <field name="model_id" ref="stock.model_stock_picking"/>
        <field name="state">code</field>
        <field name="code"><![CDATA[
for picking_type in env['stock.picking.type'].search([]):
    env['stock.picking'].with_company(
        picking_type.company_id
    ).create([
        {'picking_type_id': picking_type.id}
        for _ in range(5)
    ])
        ]]></field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
