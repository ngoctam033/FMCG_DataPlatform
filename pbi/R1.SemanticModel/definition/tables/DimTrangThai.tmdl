/// Danh mục trạng thái phiếu nhập được Việt hóa.
table DimTrangThai

	column 'Mã trạng thái'
		dataType: string
		isKey
		sourceColumn: state_key
		summarizeBy: none

	column 'Trạng thái'
		dataType: string
		sourceColumn: state_name
		summarizeBy: none

	column 'Thứ tự trạng thái'
		dataType: int64
		isHidden
		sourceColumn: state_order
		summarizeBy: none

	partition DimTrangThai = m
		mode: import
		source =
			let
				NativeResult = #table(
					type table [state_key = text, state_name = text, state_order = Int64.Type],
					{
						{"draft", "Nháp", 1},
						{"waiting", "Đang chờ", 2},
						{"confirmed", "Đang chờ", 3},
						{"assigned", "Sẵn sàng", 4},
						{"done", "Hoàn tất", 5},
						{"cancel", "Đã hủy", 6}
					}
				)
			in
				NativeResult
