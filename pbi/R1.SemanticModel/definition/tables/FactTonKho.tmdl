/// Snapshot tồn kho hiện tại tại các vị trí nội bộ. Grain: một stock.quant.
table FactTonKho

	measure 'Tồn kho thực tế' = SUM(FactTonKho[Số lượng tồn])
		formatString: #,0.00

	measure 'Tổng SL giữ chỗ' = SUM(FactTonKho[Số lượng giữ chỗ])
		formatString: #,0.00

	/// Tỷ trọng hàng đã được giữ chỗ trên tổng tồn thực tế.
	measure 'Tỷ lệ tồn đã giữ chỗ' = DIVIDE([Tổng SL giữ chỗ], [Tồn kho thực tế], 0)
		formatString: 0.0%

	measure 'Tồn kho khả dụng' = SUM(FactTonKho[Số lượng khả dụng])
		formatString: #,0.00

	measure 'Giá trị tồn kho ước tính' = SUM(FactTonKho[Giá trị tồn ước tính])
		formatString: #,0

	measure 'SKU đang tồn' = CALCULATE(DISTINCTCOUNT(FactTonKho[Mã sản phẩm]), FactTonKho[Số lượng tồn] > 0)
		formatString: #,0

	measure 'SKU hết hàng' = CALCULATE(DISTINCTCOUNT(FactTonKho[Mã sản phẩm]), FactTonKho[Số lượng khả dụng] <= 0)
		formatString: #,0

	measure 'Dòng giữ chỗ vượt tồn' = COUNTROWS(FILTER(FactTonKho, FactTonKho[Số lượng giữ chỗ] > FactTonKho[Số lượng tồn]))
		formatString: #,0

	measure '🔴 Dòng giữ chỗ vượt tồn' = [Dòng giữ chỗ vượt tồn]
		formatString: #,0

	measure 'Tuổi tồn TB (ngày)' = AVERAGE(FactTonKho[Tuổi tồn (ngày)])
		formatString: #,0.0

	column 'Mã tồn kho'
		dataType: int64
		isHidden
		sourceColumn: quant_id
		summarizeBy: none

	column 'Mã sản phẩm'
		dataType: int64
		isHidden
		sourceColumn: product_id
		summarizeBy: none

	column 'Mã vị trí'
		dataType: int64
		isHidden
		sourceColumn: location_id
		summarizeBy: none

	column 'Mã lô'
		dataType: int64
		isHidden
		sourceColumn: lot_id
		summarizeBy: none

	column 'Số lô'
		dataType: string
		sourceColumn: lot_name
		summarizeBy: none

	column 'Ngày nhập tồn'
		dataType: dateTime
		formatString: dd/MM/yyyy
		sourceColumn: in_date
		summarizeBy: none

	column 'Tuổi tồn (ngày)'
		dataType: int64
		sourceColumn: aging_days
		summarizeBy: average

	column 'Số lượng tồn'
		dataType: double
		sourceColumn: on_hand_qty
		summarizeBy: sum

	column 'Số lượng giữ chỗ'
		dataType: double
		sourceColumn: reserved_qty
		summarizeBy: sum

	column 'Số lượng khả dụng'
		dataType: double
		sourceColumn: available_qty
		summarizeBy: sum

	column 'Đơn giá tiêu chuẩn'
		dataType: double
		sourceColumn: standard_price
		summarizeBy: average

	column 'Giá trị tồn ước tính'
		dataType: double
		sourceColumn: inventory_value
		summarizeBy: sum

	column 'Giữ chỗ vượt tồn'
		dataType: boolean
		sourceColumn: is_over_reserved
		summarizeBy: none

	partition FactTonKho = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawStockQuant = Value.NativeQuery(Source, "SELECT * FROM stock_quant", null, [EnableFolding = true]),
				RawStockLocation = Value.NativeQuery(Source, "SELECT * FROM stock_location", null, [EnableFolding = true]),
				RawStockLot = Value.NativeQuery(Source, "SELECT * FROM stock_lot", null, [EnableFolding = true]),
				RawProductProduct = Value.NativeQuery(Source, "SELECT * FROM product_product", null, [EnableFolding = true]),
				InternalLocations = Table.SelectRows(RawStockLocation, each [usage] = "internal"),
				Quants = Table.NestedJoin(RawStockQuant, {"location_id"}, Table.SelectColumns(InternalLocations, {"id"}), {"id"}, "InternalLocation", JoinKind.Inner),
				JoinedLot = Table.NestedJoin(Quants, {"lot_id"}, Table.SelectColumns(RawStockLot, {"id", "name"}), {"id"}, "Lot", JoinKind.LeftOuter),
				ExpandedLot = Table.ExpandTableColumn(JoinedLot, "Lot", {"name"}, {"lot_name"}),
				JoinedProduct = Table.NestedJoin(ExpandedLot, {"product_id"}, Table.SelectColumns(RawProductProduct, {"id", "standard_price"}), {"id"}, "Product", JoinKind.Inner),
				ExpandedProduct = Table.ExpandTableColumn(JoinedProduct, "Product", {"standard_price"}, {"standard_price_raw"}),
				Filled = Table.ReplaceValue(Table.ReplaceValue(Table.ReplaceValue(ExpandedProduct, null, 0, Replacer.ReplaceValue, {"quantity", "reserved_quantity"}), null, -1, Replacer.ReplaceValue, {"lot_id"}), null, "(Không theo dõi lô)", Replacer.ReplaceValue, {"lot_name"}),
				AddedAge = Table.AddColumn(Filled, "aging_days", each List.Max({Duration.Days(Date.From(DateTime.LocalNow()) - (if [in_date] = null then Date.From(DateTime.LocalNow()) else Date.From([in_date]))), 0}), Int64.Type),
				AddedAvailable = Table.AddColumn(AddedAge, "available_qty", each [quantity] - [reserved_quantity], type number),
				AddedPrice = Table.AddColumn(AddedAvailable, "standard_price", each let value = [standard_price_raw], companyKey = Text.From([company_id]), parsedValue = if value = null or Value.Is(value, type record) then value else try Json.Document(Text.ToBinary(Text.From(value))) otherwise value, priceValue = if parsedValue = null then 0 else if Value.Is(parsedValue, type record) then Record.FieldOrDefault(parsedValue, companyKey, 0) else parsedValue in Number.From(priceValue), type number),
				AddedValue = Table.AddColumn(AddedPrice, "inventory_value", each [quantity] * [standard_price], type number),
				AddedOverReserved = Table.AddColumn(AddedValue, "is_over_reserved", each [reserved_quantity] > [quantity], type logical),
				Selected = Table.SelectColumns(AddedOverReserved, {"id", "product_id", "location_id", "lot_id", "lot_name", "in_date", "aging_days", "quantity", "reserved_quantity", "available_qty", "standard_price", "inventory_value", "is_over_reserved"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "quant_id"}, {"quantity", "on_hand_qty"}, {"reserved_quantity", "reserved_qty"}}),
				NativeResult = Table.TransformColumnTypes(Renamed, {{"quant_id", Int64.Type}, {"product_id", Int64.Type}, {"location_id", Int64.Type}, {"lot_id", Int64.Type}, {"in_date", type date}, {"aging_days", Int64.Type}, {"on_hand_qty", type number}, {"reserved_qty", type number}, {"available_qty", type number}, {"standard_price", type number}, {"inventory_value", type number}, {"is_over_reserved", type logical}})
			in
				NativeResult

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
