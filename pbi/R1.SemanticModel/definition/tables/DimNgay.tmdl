/// Lịch liên tục bao phủ toàn bộ thời gian của phiếu nhập kho.
table DimNgay

	dataCategory: Time

	column 'Ngày'
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		sourceColumn: calendar_date
		summarizeBy: none

	column 'Năm'
		dataType: int64
		sourceColumn: calendar_year
		summarizeBy: none

	column 'Tháng'
		dataType: int64
		sourceColumn: calendar_month
		summarizeBy: none

	column 'Tên tháng'
		dataType: string
		sourceColumn: month_name
		sortByColumn: 'Tháng'
		summarizeBy: none

	column 'Quý'
		dataType: string
		sourceColumn: calendar_quarter
		summarizeBy: none

	partition DimNgay = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawStockPicking = Value.NativeQuery(Source, "SELECT * FROM stock_picking", null, [EnableFolding = true]),
				RawPickingType = Value.NativeQuery(Source, "SELECT * FROM stock_picking_type", null, [EnableFolding = true]),
				IncomingTypes = Table.SelectRows(RawPickingType, each [code] = "incoming"),
				Incoming = Table.NestedJoin(RawStockPicking, {"picking_type_id"}, Table.SelectColumns(IncomingTypes, {"id"}), {"id"}, "IncomingType", JoinKind.Inner),
				Dates = List.RemoveNulls(List.Combine({List.Transform(Incoming[create_date], each if _ = null then null else Date.From(_)), List.Transform(Incoming[scheduled_date], each if _ = null then null else Date.From(_)), List.Transform(Incoming[date_done], each if _ = null then null else Date.From(_))})),
				MinDate = if List.IsEmpty(Dates) then Date.From(DateTime.LocalNow()) else List.Min(Dates),
				MaxDate = if List.IsEmpty(Dates) then Date.From(DateTime.LocalNow()) else List.Max(Dates),
				Calendar = Table.FromList(List.Dates(MinDate, Duration.Days(MaxDate - MinDate) + 1, #duration(1, 0, 0, 0)), Splitter.SplitByNothing(), {"calendar_date"}),
				AddedYear = Table.AddColumn(Calendar, "calendar_year", each Date.Year([calendar_date]), Int64.Type),
				AddedMonth = Table.AddColumn(AddedYear, "calendar_month", each Date.Month([calendar_date]), Int64.Type),
				AddedMonthName = Table.AddColumn(AddedMonth, "month_name", each "Tháng " & Text.From([calendar_month]), type text),
				NativeResult = Table.AddColumn(AddedMonthName, "calendar_quarter", each "Q" & Text.From(Date.QuarterOfYear([calendar_date])), type text)
			in
				NativeResult
