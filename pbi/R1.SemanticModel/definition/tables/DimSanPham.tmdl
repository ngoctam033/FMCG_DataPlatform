/// Danh mục sản phẩm và nhóm sản phẩm từ Odoo.
table DimSanPham

	column 'Mã sản phẩm'
		dataType: int64
		isKey
		sourceColumn: product_id
		summarizeBy: none

	column 'Sản phẩm'
		dataType: string
		sourceColumn: product_name
		summarizeBy: none

	column 'Nhóm sản phẩm'
		dataType: string
		sourceColumn: category_name
		summarizeBy: none

	column 'Có thể mua'
		dataType: boolean
		sourceColumn: purchase_ok
		summarizeBy: none

	partition DimSanPham = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawProductProduct = Value.NativeQuery(Source, "SELECT * FROM product_product", null, [EnableFolding = true]),
				RawProductTemplate = Value.NativeQuery(Source, "SELECT * FROM product_template", null, [EnableFolding = true]),
				RawProductCategory = Value.NativeQuery(Source, "SELECT * FROM product_category", null, [EnableFolding = true]),
				Products = Table.SelectColumns(RawProductProduct, {"id", "product_tmpl_id"}),
				Templates = Table.SelectColumns(RawProductTemplate, {"id", "name", "categ_id", "purchase_ok"}),
				Categories = Table.SelectColumns(RawProductCategory, {"id", "name"}),
				JoinedTemplate = Table.NestedJoin(Products, {"product_tmpl_id"}, Templates, {"id"}, "Template", JoinKind.Inner),
				ExpandedTemplate = Table.ExpandTableColumn(JoinedTemplate, "Template", {"name", "categ_id", "purchase_ok"}, {"product_name_raw", "categ_id", "purchase_ok"}),
				JoinedCategory = Table.NestedJoin(ExpandedTemplate, {"categ_id"}, Categories, {"id"}, "Category", JoinKind.LeftOuter),
				ExpandedCategory = Table.ExpandTableColumn(JoinedCategory, "Category", {"name"}, {"category_name_raw"}),
				AddedProductName = Table.AddColumn(ExpandedCategory, "product_name", each let value = [product_name_raw] in if value = null then "(Sản phẩm chưa đặt tên)" else if Value.Is(value, type record) then Record.FieldOrDefault(value, "en_US", "(Sản phẩm chưa đặt tên)") else Text.From(value), type text),
				AddedCategoryName = Table.AddColumn(AddedProductName, "category_name", each let value = [category_name_raw] in if value = null then "(Chưa phân nhóm)" else if Value.Is(value, type record) then Record.FieldOrDefault(value, "en_US", "(Chưa phân nhóm)") else Text.From(value), type text),
				Selected = Table.SelectColumns(AddedCategoryName, {"id", "product_name", "category_name", "purchase_ok"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "product_id"}}),
				FilledPurchase = Table.ReplaceValue(Renamed, null, false, Replacer.ReplaceValue, {"purchase_ok"}),
				NativeResult = Table.TransformColumnTypes(FilledPurchase, {{"product_id", Int64.Type}, {"product_name", type text}, {"category_name", type text}, {"purchase_ok", type logical}})
			in
				NativeResult
