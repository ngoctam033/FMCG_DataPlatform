/// Tồn kho theo lô và hạn dùng tại vị trí nội bộ.
table FactLoHanDung

	measure 'Số lô đang tồn' = CALCULATE(DISTINCTCOUNT(FactLoHanDung[Mã lô]), FactLoHanDung[Số lượng tồn theo lô] > 0)
		formatString: #,0

	measure 'Lô đã hết hạn' = CALCULATE(DISTINCTCOUNT(FactLoHanDung[Mã lô]), FactLoHanDung[Nhóm hạn dùng] = "Đã hết hạn", FactLoHanDung[Số lượng tồn theo lô] > 0)
		formatString: #,0

	measure 'Lô hết hạn trong 30 ngày' = CALCULATE(DISTINCTCOUNT(FactLoHanDung[Mã lô]), FactLoHanDung[Nhóm hạn dùng] = "0-30 ngày", FactLoHanDung[Số lượng tồn theo lô] > 0)
		formatString: #,0

	measure 'SL hàng đã hết hạn' = CALCULATE(SUM(FactLoHanDung[Số lượng tồn theo lô]), FactLoHanDung[Nhóm hạn dùng] = "Đã hết hạn")
		formatString: #,0.00

	measure 'Giá trị hàng rủi ro' = CALCULATE(SUM(FactLoHanDung[Giá trị theo lô]), FactLoHanDung[Nhóm hạn dùng] IN { "Đã hết hạn", "0-30 ngày" })
		formatString: #,0

	measure '🔴 Lô đã hết hạn' = [Lô đã hết hạn]
		formatString: #,0

	measure '🟠 Lô hết hạn 0-30 ngày' = [Lô hết hạn trong 30 ngày]
		formatString: #,0

	measure '🔵 Lô hết hạn 31-60 ngày' = CALCULATE(DISTINCTCOUNT(FactLoHanDung[Mã lô]), FactLoHanDung[Nhóm hạn dùng] = "31-60 ngày", FactLoHanDung[Số lượng tồn theo lô] > 0)
		formatString: #,0

	column 'Mã dòng tồn lô'
		dataType: int64
		isHidden
		sourceColumn: quant_id
		summarizeBy: none

	column 'Mã lô'
		dataType: int64
		isHidden
		sourceColumn: lot_id
		summarizeBy: none

	column 'Số lô'
		dataType: string
		sourceColumn: lot_name
		summarizeBy: none

	column 'Mã sản phẩm'
		dataType: int64
		isHidden
		sourceColumn: product_id
		summarizeBy: none

	column 'Mã vị trí'
		dataType: int64
		isHidden
		sourceColumn: location_id
		summarizeBy: none

	column 'Ngày hết hạn'
		dataType: dateTime
		formatString: dd/MM/yyyy
		sourceColumn: expiration_date
		summarizeBy: none

	column 'Số ngày tới hạn'
		dataType: int64
		sourceColumn: days_to_expiry
		summarizeBy: none

	column 'Nhóm hạn dùng'
		dataType: string
		sourceColumn: expiry_bucket
		sortByColumn: 'Thứ tự nhóm hạn dùng'
		summarizeBy: none

	column 'Cảnh báo hạn dùng' = SWITCH(FactLoHanDung[Nhóm hạn dùng], "Đã hết hạn", "🔴 Đã hết hạn", "0-30 ngày", "🟠 Còn 0-30 ngày", "31-60 ngày", "🔵 Còn 31-60 ngày", "🟢 Bình thường")
		dataType: string
		summarizeBy: none

	column 'Thứ tự nhóm hạn dùng'
		dataType: int64
		isHidden
		sourceColumn: expiry_bucket_order
		summarizeBy: none

	column 'Số lượng tồn theo lô'
		dataType: double
		sourceColumn: lot_qty
		summarizeBy: sum

	column 'Giá trị theo lô'
		dataType: double
		sourceColumn: lot_value
		summarizeBy: sum

	partition FactLoHanDung = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawStockQuant = Value.NativeQuery(Source, "SELECT * FROM stock_quant", null, [EnableFolding = true]),
				RawStockLocation = Value.NativeQuery(Source, "SELECT * FROM stock_location", null, [EnableFolding = true]),
				RawStockLot = Value.NativeQuery(Source, "SELECT * FROM stock_lot", null, [EnableFolding = true]),
				RawProductProduct = Value.NativeQuery(Source, "SELECT * FROM product_product", null, [EnableFolding = true]),
				InternalLocations = Table.SelectRows(RawStockLocation, each [usage] = "internal"),
				Quants = Table.NestedJoin(RawStockQuant, {"location_id"}, Table.SelectColumns(InternalLocations, {"id"}), {"id"}, "InternalLocation", JoinKind.Inner),
				JoinedLot = Table.NestedJoin(Quants, {"lot_id"}, Table.SelectColumns(RawStockLot, {"id", "name", "expiration_date"}), {"id"}, "Lot", JoinKind.Inner),
				ExpandedLot = Table.ExpandTableColumn(JoinedLot, "Lot", {"id", "name", "expiration_date"}, {"joined_lot_id", "lot_name", "lot_expiration_date"}),
				JoinedProduct = Table.NestedJoin(ExpandedLot, {"product_id"}, Table.SelectColumns(RawProductProduct, {"id", "standard_price"}), {"id"}, "Product", JoinKind.Inner),
				ExpandedProduct = Table.ExpandTableColumn(JoinedProduct, "Product", {"standard_price"}, {"standard_price_raw"}),
				FilledQty = Table.ReplaceValue(ExpandedProduct, null, 0, Replacer.ReplaceValue, {"quantity"}),
				AddedDays = Table.AddColumn(FilledQty, "days_to_expiry", each if [lot_expiration_date] = null then null else Duration.Days(Date.From([lot_expiration_date]) - Date.From(DateTime.LocalNow())), Int64.Type),
				AddedBucket = Table.AddColumn(AddedDays, "expiry_bucket", each if [days_to_expiry] = null then "Không có hạn dùng" else if [days_to_expiry] < 0 then "Đã hết hạn" else if [days_to_expiry] <= 30 then "0-30 ngày" else if [days_to_expiry] <= 60 then "31-60 ngày" else if [days_to_expiry] <= 90 then "61-90 ngày" else "Trên 90 ngày", type text),
				AddedBucketOrder = Table.AddColumn(AddedBucket, "expiry_bucket_order", each if [days_to_expiry] = null then 6 else if [days_to_expiry] < 0 then 1 else if [days_to_expiry] <= 30 then 2 else if [days_to_expiry] <= 60 then 3 else if [days_to_expiry] <= 90 then 4 else 5, Int64.Type),
				AddedPrice = Table.AddColumn(AddedBucketOrder, "standard_price", each let value = [standard_price_raw], companyKey = Text.From([company_id]) in if value = null then 0 else if Value.Is(value, type record) then Number.From(Record.FieldOrDefault(value, companyKey, 0)) else Number.From(value), type number),
				AddedValue = Table.AddColumn(AddedPrice, "lot_value", each [quantity] * [standard_price], type number),
				Selected = Table.SelectColumns(AddedValue, {"id", "joined_lot_id", "lot_name", "product_id", "location_id", "lot_expiration_date", "days_to_expiry", "expiry_bucket", "expiry_bucket_order", "quantity", "lot_value"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "quant_id"}, {"joined_lot_id", "lot_id"}, {"lot_expiration_date", "expiration_date"}, {"quantity", "lot_qty"}}),
				NativeResult = Table.TransformColumnTypes(Renamed, {{"quant_id", Int64.Type}, {"lot_id", Int64.Type}, {"product_id", Int64.Type}, {"location_id", Int64.Type}, {"expiration_date", type date}, {"days_to_expiry", Int64.Type}, {"expiry_bucket_order", Int64.Type}, {"lot_qty", type number}, {"lot_value", type number}})
			in
				NativeResult

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
