/// Danh mục nhà cung cấp; bản ghi -1 đại diện cho phiếu chưa gán nhà cung cấp.
table DimNhaCungCap

	column 'Mã nhà cung cấp'
		dataType: int64
		isKey
		sourceColumn: supplier_id
		summarizeBy: none

	column 'Nhà cung cấp'
		dataType: string
		sourceColumn: supplier_name
		summarizeBy: none

	partition DimNhaCungCap = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawResPartner = Value.NativeQuery(Source, "SELECT * FROM res_partner", null, [EnableFolding = true]),
				Suppliers = Table.SelectRows(RawResPartner, each [supplier_rank] > 0),
				Selected = Table.SelectColumns(Suppliers, {"id", "name"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "supplier_id"}, {"name", "supplier_name"}}),
				FilledNames = Table.ReplaceValue(Renamed, null, "(Nhà cung cấp chưa đặt tên)", Replacer.ReplaceValue, {"supplier_name"}),
				Unknown = #table(type table [supplier_id = Int64.Type, supplier_name = text], {{-1, "(Không có nhà cung cấp)"}}),
				Result = Table.Combine({Unknown, FilledNames}),
				NativeResult = Table.TransformColumnTypes(Result, {{"supplier_id", Int64.Type}, {"supplier_name", type text}})
			in
				NativeResult
