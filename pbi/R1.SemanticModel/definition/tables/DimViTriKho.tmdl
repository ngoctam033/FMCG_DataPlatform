/// Danh mục vị trí kho, dùng đồng thời cho kho nhận và vị trí nguồn.
table DimViTriKho

	column 'Mã vị trí'
		dataType: int64
		isKey
		sourceColumn: location_id
		summarizeBy: none

	column 'Vị trí kho'
		dataType: string
		sourceColumn: location_name
		summarizeBy: none

	column 'Loại vị trí'
		dataType: string
		sourceColumn: usage_type
		summarizeBy: none

	partition DimViTriKho = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawStockLocation = Value.NativeQuery(Source, "SELECT * FROM stock_location", null, [EnableFolding = true]),
				Selected = Table.SelectColumns(RawStockLocation, {"id", "complete_name", "name", "usage"}),
				AddedName = Table.AddColumn(Selected, "location_name", each if [complete_name] <> null then [complete_name] else if [name] <> null then [name] else "(Không xác định)", type text),
				Projected = Table.SelectColumns(AddedName, {"id", "location_name", "usage"}),
				Renamed = Table.RenameColumns(Projected, {{"id", "location_id"}, {"usage", "usage_type"}}),
				NativeResult = Table.TransformColumnTypes(Renamed, {{"location_id", Int64.Type}, {"location_name", type text}, {"usage_type", type text}})
			in
				NativeResult
