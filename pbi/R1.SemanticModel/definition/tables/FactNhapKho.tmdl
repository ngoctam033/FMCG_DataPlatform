/// Bảng sự kiện nhập kho. Grain: một dòng dịch chuyển sản phẩm trong một phiếu nhập.
table FactNhapKho

	measure 'Số phiếu nhập' = DISTINCTCOUNT(FactNhapKho[Mã phiếu nhập])
		formatString: #,0

	measure 'Tổng SL yêu cầu' = SUM(FactNhapKho[Số lượng yêu cầu])
		formatString: #,0.00

	measure 'Tổng SL đã nhận' = SUM(FactNhapKho[Số lượng đã nhận])
		formatString: #,0.00

	measure 'Tổng SL còn thiếu' = SUM(FactNhapKho[Số lượng còn thiếu])
		formatString: #,0.00

	measure 'Tỷ lệ nhận hàng' = DIVIDE([Tổng SL đã nhận], [Tổng SL yêu cầu], 0)
		formatString: 0.0%

	measure 'Phiếu đang mở' = CALCULATE([Số phiếu nhập], NOT(FactNhapKho[Mã trạng thái] IN { "done", "cancel" }))
		formatString: #,0

	measure 'Phiếu nhập quá hạn' = CALCULATE([Số phiếu nhập], FILTER(FactNhapKho, NOT(FactNhapKho[Mã trạng thái] IN { "done", "cancel" }) && FactNhapKho[Ngày dự kiến] < TODAY()))
		formatString: #,0

	measure 'Dòng nhận vượt yêu cầu' = COUNTROWS(FILTER(FactNhapKho, FactNhapKho[Số lượng đã nhận] > FactNhapKho[Số lượng yêu cầu]))
		formatString: #,0

	measure 'SL nhận vượt yêu cầu' = SUMX(FILTER(FactNhapKho, FactNhapKho[Số lượng đã nhận] > FactNhapKho[Số lượng yêu cầu]), FactNhapKho[Số lượng đã nhận] - FactNhapKho[Số lượng yêu cầu])
		formatString: #,0.00

	measure 'Thời gian xử lý TB (giờ)' = AVERAGE(FactNhapKho[Thời gian xử lý (giờ)])
		formatString: #,0.0

	column 'Mã dòng nhập'
		dataType: int64
		isHidden
		sourceColumn: move_id
		summarizeBy: none

	column 'Mã phiếu nhập'
		dataType: int64
		isHidden
		sourceColumn: picking_id
		summarizeBy: none

	column 'Phiếu nhập'
		dataType: string
		sourceColumn: receipt_name
		summarizeBy: none

	column 'Ngày tạo phiếu'
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: receipt_date
		summarizeBy: none

	column 'Ngày dự kiến'
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: scheduled_date
		summarizeBy: none

	column 'Ngày hoàn tất'
		dataType: dateTime
		formatString: yyyy-MM-dd
		sourceColumn: completed_date
		summarizeBy: none

	column 'Mã trạng thái'
		dataType: string
		isHidden
		sourceColumn: state_key
		summarizeBy: none

	column 'Mã nhà cung cấp'
		dataType: int64
		isHidden
		sourceColumn: supplier_id
		summarizeBy: none

	column 'Mã nhân viên'
		dataType: int64
		isHidden
		sourceColumn: employee_id
		summarizeBy: none

	column 'Mã sản phẩm'
		dataType: int64
		isHidden
		sourceColumn: product_id
		summarizeBy: none

	column 'Mã vị trí nguồn'
		dataType: int64
		isHidden
		sourceColumn: source_location_id
		summarizeBy: none

	column 'Mã kho nhận'
		dataType: int64
		isHidden
		sourceColumn: destination_location_id
		summarizeBy: none

	column 'Số lượng yêu cầu'
		dataType: double
		sourceColumn: requested_qty
		summarizeBy: sum

	column 'Số lượng đã nhận'
		dataType: double
		sourceColumn: received_qty
		summarizeBy: sum

	column 'Số lượng còn thiếu'
		dataType: double
		sourceColumn: remaining_qty
		summarizeBy: sum

	column 'Đã lấy hàng'
		dataType: boolean
		sourceColumn: is_picked
		summarizeBy: none

	column 'Thời gian xử lý (giờ)'
		dataType: double
		sourceColumn: cycle_hours
		summarizeBy: average

	partition FactNhapKho = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(
					#"OdooServer" & ":" & #"OdooPort",
					#"OdooDatabase",
					[CreateNavigationProperties = false]
				),
				RawStockMove = Value.NativeQuery(Source, "SELECT * FROM stock_move", null, [EnableFolding = true]),
				RawStockPicking = Value.NativeQuery(Source, "SELECT * FROM stock_picking", null, [EnableFolding = true]),
				RawPickingType = Value.NativeQuery(Source, "SELECT * FROM stock_picking_type", null, [EnableFolding = true]),
				IncomingTypes = Table.SelectRows(RawPickingType, each [code] = "incoming"),
				IncomingPickings = Table.NestedJoin(RawStockPicking, {"picking_type_id"}, Table.SelectColumns(IncomingTypes, {"id"}), {"id"}, "IncomingType", JoinKind.Inner),
				PickingColumns = Table.SelectColumns(IncomingPickings, {"id", "name", "create_date", "scheduled_date", "date_done", "state", "partner_id", "user_id"}),
				MoveColumns = Table.SelectColumns(RawStockMove, {"id", "picking_id", "product_id", "location_id", "location_dest_id", "product_uom_qty", "quantity", "picked"}),
				Joined = Table.NestedJoin(MoveColumns, {"picking_id"}, PickingColumns, {"id"}, "Picking", JoinKind.Inner),
				Expanded = Table.ExpandTableColumn(Joined, "Picking", {"name", "create_date", "scheduled_date", "date_done", "state", "partner_id", "user_id"}, {"receipt_name", "receipt_date", "scheduled_date", "completed_date", "state_key", "supplier_id", "employee_id"}),
				Filled = Table.ReplaceValue(Table.ReplaceValue(Table.ReplaceValue(Table.ReplaceValue(Table.ReplaceValue(Expanded, null, -1, Replacer.ReplaceValue, {"supplier_id", "employee_id"}), null, 0, Replacer.ReplaceValue, {"product_uom_qty", "quantity"}), null, false, Replacer.ReplaceValue, {"picked"}), null, null, Replacer.ReplaceValue, {"completed_date"}), null, null, Replacer.ReplaceValue, {"scheduled_date"}),
				AddedRemaining = Table.AddColumn(Filled, "remaining_qty", each List.Max({[product_uom_qty] - [quantity], 0}), type number),
				AddedCycle = Table.AddColumn(AddedRemaining, "cycle_hours", each if [completed_date] = null then null else Duration.TotalHours([completed_date] - [receipt_date]), type number),
				Selected = Table.SelectColumns(AddedCycle, {"id", "picking_id", "receipt_name", "receipt_date", "scheduled_date", "completed_date", "state_key", "supplier_id", "employee_id", "product_id", "location_id", "location_dest_id", "product_uom_qty", "quantity", "remaining_qty", "picked", "cycle_hours"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "move_id"}, {"location_id", "source_location_id"}, {"location_dest_id", "destination_location_id"}, {"product_uom_qty", "requested_qty"}, {"quantity", "received_qty"}, {"picked", "is_picked"}}),
				NativeResult = Table.TransformColumnTypes(Renamed, {{"move_id", Int64.Type}, {"picking_id", Int64.Type}, {"receipt_date", type date}, {"scheduled_date", type date}, {"completed_date", type date}, {"supplier_id", Int64.Type}, {"employee_id", Int64.Type}, {"product_id", Int64.Type}, {"source_location_id", Int64.Type}, {"destination_location_id", Int64.Type}, {"requested_qty", type number}, {"received_qty", type number}, {"remaining_qty", type number}, {"is_picked", type logical}, {"cycle_hours", type number}})
			in
				NativeResult
