/// Danh mục người dùng phụ trách phiếu nhập.
table DimNhanVien

	column 'Mã nhân viên'
		dataType: int64
		isKey
		sourceColumn: employee_id
		summarizeBy: none

	column 'Nhân viên phụ trách'
		dataType: string
		sourceColumn: employee_name
		summarizeBy: none

	partition DimNhanVien = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawResUsers = Value.NativeQuery(Source, "SELECT * FROM res_users", null, [EnableFolding = true]),
				RawResPartner = Value.NativeQuery(Source, "SELECT * FROM res_partner", null, [EnableFolding = true]),
				Users = Table.SelectColumns(RawResUsers, {"id", "partner_id"}),
				Partners = Table.SelectColumns(RawResPartner, {"id", "name"}),
				Joined = Table.NestedJoin(Users, {"partner_id"}, Partners, {"id"}, "Partner", JoinKind.LeftOuter),
				Expanded = Table.ExpandTableColumn(Joined, "Partner", {"name"}, {"employee_name"}),
				Selected = Table.SelectColumns(Expanded, {"id", "employee_name"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "employee_id"}}),
				FilledNames = Table.ReplaceValue(Renamed, null, "(Người dùng chưa đặt tên)", Replacer.ReplaceValue, {"employee_name"}),
				Unknown = #table(type table [employee_id = Int64.Type, employee_name = text], {{-1, "(Chưa phân công)"}}),
				Result = Table.Combine({Unknown, FilledNames}),
				NativeResult = Table.TransformColumnTypes(Result, {{"employee_id", Int64.Type}, {"employee_name", type text}})
			in
				NativeResult
