/// Chính sách min/max và nhu cầu bổ sung tại từng sản phẩm-vị trí.
table FactBoSungHang

	measure 'SKU cần bổ sung' = CALCULATE(DISTINCTCOUNT(FactBoSungHang[Mã sản phẩm]), FactBoSungHang[Cần bổ sung] = TRUE())
		formatString: #,0

	measure 'Tổng SL cần bổ sung tối thiểu' = SUM(FactBoSungHang[SL cần bổ sung tối thiểu])
		formatString: #,0.00

	measure 'Tổng SL đề xuất tới mức tối đa' = SUM(FactBoSungHang[SL đề xuất tới mức tối đa])
		formatString: #,0.00

	measure 'Tỷ lệ SKU dưới Min' = DIVIDE([SKU cần bổ sung], DISTINCTCOUNT(FactBoSungHang[Mã sản phẩm]), 0)
		formatString: 0.0%

	/// Không suy diễn hết hàng từ orderpoint vì qty_on_hand không được lưu trong PostgreSQL.
	measure '🔴 SKU hết hàng' = BLANK()
		formatString: #,0

	/// Odoo đã tính nhu cầu bổ sung trong qty_to_order_computed/qty_to_order_manual.
	measure '🟠 SKU dưới Min' = [SKU cần bổ sung]
		formatString: #,0

	/// Theo dõi: tồn từ Min đến Min cộng biên an toàn 20%.
	measure '🔵 SKU gần Min' = BLANK()
		formatString: #,0

	/// Cảnh báo dư hàng: tồn cao hơn Max nhưng chưa vượt 120% Max.
	measure '🟠 SKU vượt Max' = BLANK()
		formatString: #,0

	/// Khẩn cấp dư hàng: tồn cao hơn 120% Max.
	measure '🔴 SKU vượt 120% Max' = BLANK()
		formatString: #,0

	column 'Mã quy tắc'
		dataType: int64
		isHidden
		sourceColumn: orderpoint_id
		summarizeBy: none

	column 'Quy tắc bổ sung'
		dataType: string
		sourceColumn: orderpoint_name
		summarizeBy: none

	column 'Mã sản phẩm'
		dataType: int64
		isHidden
		sourceColumn: product_id
		summarizeBy: none

	column 'Mã vị trí'
		dataType: int64
		isHidden
		sourceColumn: location_id
		summarizeBy: none

	column 'Tồn khả dụng'
		dataType: double
		isHidden
		sourceColumn: available_qty
		summarizeBy: sum

	column 'Mức tồn tối thiểu'
		dataType: double
		sourceColumn: min_qty
		summarizeBy: sum

	column 'Mức tồn tối đa'
		dataType: double
		sourceColumn: max_qty
		summarizeBy: sum

	column 'SL cần bổ sung tối thiểu'
		dataType: double
		isHidden
		sourceColumn: min_replenishment_qty
		summarizeBy: sum

	column 'SL đề xuất tới mức tối đa'
		dataType: double
		sourceColumn: target_replenishment_qty
		summarizeBy: sum

	column 'Cần bổ sung'
		dataType: boolean
		sourceColumn: needs_replenishment
		summarizeBy: none

	/// Nhãn dựa trên kết quả replenishment chính thức do Odoo đã tính.
	column 'Trạng thái cảnh báo' = IF(FactBoSungHang[Cần bổ sung], "🟠 Cần bổ sung", "🟢 Không cần bổ sung")
		dataType: string
		sortByColumn: 'Thứ tự cảnh báo'
		summarizeBy: none

	column 'Thứ tự cảnh báo' = IF(FactBoSungHang[Cần bổ sung], 1, 2)
		dataType: int64
		isHidden
		summarizeBy: none

	partition FactBoSungHang = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(#"OdooServer" & ":" & #"OdooPort", #"OdooDatabase", [CreateNavigationProperties = false]),
				RawOrderpoint = Value.NativeQuery(Source, "SELECT * FROM stock_warehouse_orderpoint", null, [EnableFolding = true]),
				ActiveOrderpoints = Table.SelectRows(RawOrderpoint, each [active] = null or [active] = true),
				Filled = Table.ReplaceValue(Table.ReplaceValue(Table.ReplaceValue(Table.ReplaceValue(ActiveOrderpoints, null, 0, Replacer.ReplaceValue, {"product_min_qty", "product_max_qty", "qty_to_order_computed", "qty_to_order_manual"}), null, "", Replacer.ReplaceValue, {"name"}), null, -1, Replacer.ReplaceValue, {"product_id"}), null, -1, Replacer.ReplaceValue, {"location_id"}),
				AddedName = Table.AddColumn(Filled, "orderpoint_name", each if [name] = "" then "OP/" & Text.From([id]) else [name], type text),
				AddedOrderQty = Table.AddColumn(AddedName, "effective_order_qty", each if [qty_to_order_manual] <> 0 then [qty_to_order_manual] else [qty_to_order_computed], type number),
				AddedAvailable = Table.AddColumn(AddedOrderQty, "available_qty", each null, type nullable number),
				AddedMinimum = Table.AddColumn(AddedAvailable, "min_replenishment_qty", each [effective_order_qty], type number),
				AddedTarget = Table.AddColumn(AddedMinimum, "target_replenishment_qty", each [effective_order_qty], type number),
				AddedNeeds = Table.AddColumn(AddedTarget, "needs_replenishment", each [effective_order_qty] > 0, type logical),
				Selected = Table.SelectColumns(AddedNeeds, {"id", "orderpoint_name", "product_id", "location_id", "available_qty", "product_min_qty", "product_max_qty", "min_replenishment_qty", "target_replenishment_qty", "needs_replenishment"}),
				Renamed = Table.RenameColumns(Selected, {{"id", "orderpoint_id"}, {"product_min_qty", "min_qty"}, {"product_max_qty", "max_qty"}}),
				NativeResult = Table.TransformColumnTypes(Renamed, {{"orderpoint_id", Int64.Type}, {"orderpoint_name", type text}, {"product_id", Int64.Type}, {"location_id", Int64.Type}, {"available_qty", type nullable number}, {"min_qty", type number}, {"max_qty", type number}, {"min_replenishment_qty", type number}, {"target_replenishment_qty", type number}, {"needs_replenishment", type logical}})
			in
				NativeResult

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation
